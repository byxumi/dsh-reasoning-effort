{
  "name": "dsh-reasoning-effort",
  "version": "1.2.5",
  "description": "DSH reasoning effort plugin — enables reasoning effort selection in the official model selector. Installable via `dsh plugin --profile web add github:byxumi/dsh-reasoning-effort#main`",
  "private": true,
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "scripts": {
    "install": "node install.js --off",
    "list": "node install.js --list",
    "help": "node install.js --help",
    "uninstall": "node uninstall.js"
  },
  "files": [
    "lib/index.js",
    "patch.yml",
    "install.js",
    "install.bat",
    "uninstall.js",
    "uninstall.bat",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reasoning-effort",
    "pi-ai",
    "model-selector",
    "thinking"
  ]
}
