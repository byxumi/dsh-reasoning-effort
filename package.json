{
  "name": "dsh-reasoning-effort",
  "version": "1.4.0",
  "description": "DSH reasoning effort plugin — enables reasoning effort selection in the official model selector. Installable via `dsh plugin --profile web add`",
  "private": true,
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "scripts": {
    "install": "node install.js --off",
    "list": "node install.js --list",
    "uninstall": "node uninstall.js --all",
    "remove": "node uninstall.js --all",
    "help": "node install.js --help"
  },
  "files": [
    "lib/index.js",
    "patch.yml",
    "install.js",
    "install.bat",
    "uninstall.js",
    "uninstall.bat",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "license": "MIT",
  "author": {
    "name": "byxumi",
    "url": "https://github.com/byxumi"
  },
  "contributors": [
    {
      "name": "byxumi",
      "url": "https://github.com/byxumi"
    }
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reasoning-effort",
    "pi-ai",
    "model-selector",
    "thinking"
  ]
}
